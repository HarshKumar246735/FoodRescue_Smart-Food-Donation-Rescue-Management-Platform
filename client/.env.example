# Base URL of the API, including /api/v1 (no trailing slash)
VITE_API_URL=http://localhost:5000/api/v1
# Origin of the Socket.IO server
VITE_SOCKET_URL=http://localhost:5000
# Optional: raster tile URL for Leaflet. Empty uses OpenStreetMap's tiles (fine for development;
# use a hosted provider such as MapTiler/Stadia/Geoapify for production traffic).
VITE_MAP_TILE_URL=
