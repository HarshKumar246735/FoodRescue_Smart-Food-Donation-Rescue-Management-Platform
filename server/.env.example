# ---- Required ----
NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
COOKIE_NAME=foodrescue_token

# ---- Optional: images (photo upload is disabled without these) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Optional: email (in development without SMTP, new accounts are auto-verified) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FoodRescue <no-reply@example.com>

# ---- Optional: background jobs (falls back to in-process node-cron when empty) ----
REDIS_URL=

# ---- Optional: geocoding (Geoapify-compatible API; do NOT point at public Nominatim) ----
GEOCODER_URL=https://api.geoapify.com/v1/geocode/search
GEOCODER_API_KEY=
